generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  category      String
  name          String
  priceCents    Int
  image         String
  volumeMl      Int
  abv           Float
  descriptionEn String
  descriptionPt String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
